# ---------------------------------------------------------------------------
# Material Mundi — Environment Variables
# Copy this file to `.env` (root) and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
PORT=5000

# MongoDB
# Local:        mongodb://127.0.0.1:27017/material_mundi
# Docker:       mongodb://mongo:27017/material_mundi?replicaSet=rs0
# Atlas:        mongodb+srv://user:pass@cluster.mongodb.net/material_mundi
MONGO_URI=mongodb://127.0.0.1:27017/material_mundi

# Authentication (use long, random secrets in production, e.g. `openssl rand -hex 64`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password reset
PASSWORD_RESET_EXPIRES_MINUTES=30

# Frontend origin (comma separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Cookies
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Set to "local" to store uploads on disk during development (never in MongoDB)
IMAGE_STORAGE=cloudinary
LOCAL_UPLOAD_DIR=uploads

# Email (console | smtp | resend)
EMAIL_PROVIDER=console
EMAIL_FROM="Material Mundi <no-reply@materialmundi.com>"
EMAIL_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate limiting (per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
# Image uploads get a stricter dedicated limit
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30

# Logging
LOG_LEVEL=info
